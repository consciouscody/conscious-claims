# Buzz Configuration
BUZZ_URL=wss://conscious-command.communities.buzz.xyz

# Hermes Configuration
HERMES_URL=http://localhost:3001

# Agent Configuration
NODE_ENV=development
LOG_LEVEL=info

# Websites to Audit (comma-separated)
WEBSITES_TO_AUDIT=https://consciousclaims.com,https://conscious-optimization.com,https://skool-training.com

# Audit Frequency (milliseconds) - default 1 hour
AUDIT_INTERVAL=3600000

# Optional: Lighthouse API Key (for real scoring)
LIGHTHOUSE_API_KEY=

# Optional: SerpAPI Key (for keyword rankings)
SERPAPI_API_KEY=
