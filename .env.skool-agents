# SKOOL AGENTS - ENVIRONMENT CONFIG
# Copy this to .env before deploying

# Anthropic API (for Blueprint and Command to think)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Buzz Workspace
BUZZ_URL=wss://conscious-command.communities.buzz.xyz

# Agent Nostr Keys (cryptographic identities in Buzz)
# Each agent has its own key so it has a unique identity
BLUEPRINT_NSEC=nsec1blueprint000000000000000000000000000000000000000000000001
WARDEN_NSEC=nsec1warden00000000000000000000000000000000000000000000000002
COMMAND_NSEC=nsec1command00000000000000000000000000000000000000000000000003
RELAY_NSEC=nsec1relay000000000000000000000000000000000000000000000000004

# Twilio (for Warden voice + SMS alerts)
TWILIO_ACCOUNT_SID=your_sid_here
TWILIO_AUTH_TOKEN=your_token_here
TWILIO_PHONE_NUMBER=470-740-5774

# Google Sheets (for LOTO logging)
GOOGLE_SHEETS_API_KEY=your_key_here
LOTO_SHEET_ID=your_sheet_id_here

# Smartsheet (for energization tracking)
SMARTSHEET_API_TOKEN=your_token_here
ENERGIZATION_SHEET_ID=your_sheet_id_here

# Skool API (for posting modules)
SKOOL_API_KEY=your_key_here
SKOOL_COMMUNITY_ID=your_community_id_here

# Deployment
NODE_ENV=production
PORT=3000
