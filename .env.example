# Copy this file to .env and fill in what you have.

# Needed to name a shingle from a photo.
# Any OpenAI-compatible key works (OpenAI, or another host that speaks the same API).
OPENAI_API_KEY=

# Optional. Leave blank to use https://api.openai.com/v1
OPENAI_BASE_URL=

# Optional. Leave blank to use gpt-4o-mini
OPENAI_MODEL=

# Optional. Jobs and the dashboard need MySQL. Shingle Identifier does not.
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/conscious_claims

# Optional. Change this if more than one person will use the same copy of the app.
JWT_SECRET=change-me-if-you-share-this-machine

# Leave these empty to skip Manus login and use a local session on your computer.
# OAUTH_SERVER_URL=
# VITE_OAUTH_PORTAL_URL=
# VITE_APP_ID=local-dev

# Set to 1 to force local sign-in even if OAuth vars are present.
# LOCAL_DEV_AUTH=1
