# Anthropic API - Required for Claude integration
ANTHROPIC_API_KEY=sk-ant-...your-key-here...

# Buzz WebSocket - Required for agent connectivity
BUZZ_URL=wss://consious-command.communities.buzz.xyz

# Hermes Orchestrator - Optional (local coordination)
HERMES_URL=http://localhost:3001

# Bridge HTTP Server - Optional (defaults to 9000)
BRIDGE_PORT=9000

# Tailscale - Optional (for mesh networking)
TAILSCALE_SOCKET=/var/run/tailscale/tailscaled.sock

# External Service Keys - Optional (for Zapier integrations)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# ELEVENLABS_API_KEY=
# GOOGLE_SHEETS_API_KEY=
# SMARTSHEET_API_TOKEN=
